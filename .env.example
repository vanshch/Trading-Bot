# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram User ID allowed to interact with the bot
ALLOWED_USER_ID=

# Twelve Data API Key (primary market data feed for XAU/USD)
TWELVE_DATA_API_KEY=

# Default timeframe (5m, 15m, 1h, 4h)
DEFAULT_TIMEFRAME=15m

# Log Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Browserless screenshot enrichment (disabled by default)
CHART_SCREENSHOTS_ENABLED=false
BROWSERLESS_API_TOKEN=
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io
BROWSERLESS_PROFILE=tradingview-test
# Set your saved TradingView layout URL to include its drawings and indicators.
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/
