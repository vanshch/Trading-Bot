# Groq API Key(s) for Speech-to-Text (comma-separated for multi-key rotation / fallback)
GROQ_API_KEYS=
GROQ_API_KEY=

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=

# Optional text verification fallback providers (missing keys skip that provider)
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
